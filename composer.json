{
    "name": "genesisdb/neos-genesisdb",
    "description": "GenesisDB for Neos Flow, a wrapper around the official GenesisDB PHP client",
    "type": "neos-package",
    "license": "MIT",
    "keywords": ["genesisdb", "neos", "flow", "event-sourcing", "event-store", "cloudevents"],
    "homepage": "https://www.genesisdb.io",
    "authors": [
        { "name": "Patric Eckhart", "email": "mail@genesisdb.io" }
    ],
    "support": {
        "docs": "https://docs.genesisdb.io",
        "source": "https://github.com/genesisdb-io/genesisdb-io-neos",
        "issues": "https://github.com/genesisdb-io/genesisdb-io-neos/issues"
    },
    "require": {
        "php": ">=8.2",
        "neos/flow": "^8.0 || ^9.0",
        "genesisdb/client-sdk": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "GenesisDB\\Neos\\GenesisDB\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "GenesisDB.Neos.GenesisDB"
        }
    }
}
